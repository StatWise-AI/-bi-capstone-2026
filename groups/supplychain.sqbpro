<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="supplychain.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2928"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Orders" custom_title="0" dock_id="1" table="4,6:mainOrders"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011300ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE Orders (

Order_ID TEXT,
Product_ID TEXT,
Product_Category TEXT,
Supplier TEXT,
Warehouse TEXT,

Inventory_Quantity INTEGER,
Reorder_Level INTEGER,

Lead_Time INTEGER,

Transportation_Cost REAL,

Delivery_Date TEXT,

Sales_Quantity INTEGER,
Sales_Revenue REAL,

Customer_Region TEXT,

Order_Status TEXT,

Purchase_Cost REAL,

Profit_Margin REAL

);

SELECT COUNT(*)
FROM clean_supply_chain ;


SELECT *
FROM clean_supply_chain
LIMIT 10;


PRAGMA table_info(clean_supply_chain);


SELECT DISTINCT Supplier
FROM clean_supply_chain;


SELECT DISTINCT Warehouse
FROM clean_supply_chain;


SELECT
Supplier,
AVG(&quot;Lead Time&quot;) AS Average_Lead_Time
FROM clean_supply_chain
GROUP BY Supplier
ORDER BY Average_Lead_Time;


SELECT
    &quot;Customer Region&quot;,
    SUM(&quot;Sales Revenue&quot;) AS Revenue
FROM clean_supply_chain
GROUP BY &quot;Customer Region&quot;
ORDER BY Revenue DESC;


SELECT
    &quot;Product ID&quot;,
    AVG(&quot;Profit Margin&quot;) AS Profit
FROM clean_supply_chain
GROUP BY &quot;Product ID&quot;;


SELECT
    &quot;Product ID&quot;,
    &quot;Inventory Quantity&quot;,
    &quot;Reorder Level&quot;
FROM clean_supply_chain
WHERE &quot;Inventory Quantity&quot; &lt; &quot;Reorder Level&quot;;


SELECT
    SUM(&quot;Sales Revenue&quot;) AS Total_Revenue
FROM clean_supply_chain;


SELECT
    SUM(Profit) AS Total_Profit
FROM clean_supply_chain;


SELECT
    AVG(&quot;Lead Time&quot;) AS Average_Lead_Time
FROM clean_supply_chain;


SELECT COUNT(*) FROM clean_supply_chain;</sql><current_tab id="0"/></tab_sql></sqlb_project>
